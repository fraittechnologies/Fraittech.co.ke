# Fraittech — Apache rules for production (fraittech.co.ke)
# Requires: AllowOverride All (or equivalent) and mod_rewrite enabled.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical URL: HTTPS + non-www ---
  # Treat X-Forwarded-Proto as HTTPS (cPanel / reverse proxy); avoid redirect loops.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://fraittech.co.ke%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.fraittech\.co\.ke$ [NC]
  RewriteRule ^ https://fraittech.co.ke%{REQUEST_URI} [R=301,L]

  # --- Homepage: index.html and /home → site root (canonical) ---
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^home/?$ / [R=301,L]

  # --- Strip .html from the address bar (301) — after index rule above ---
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html(\?|\s) [NC]
  RewriteRule ^ /%1 [R=301,L,QSA]

  # --- Extensionless URLs: /page → page.html if it exists ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# --- No directory listings ---
Options -Indexes

# --- Block direct web access to sensitive files (PHP includes still work) ---
<IfModule mod_authz_core.c>
  <Files ".env">
    Require all denied
  </Files>
  <Files "config.php">
    Require all denied
  </Files>
</IfModule>

# Default index documents
DirectoryIndex index.html index.php
